# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Never commit .env. Anything prefixed NEXT_PUBLIC_ is bundled into the
# browser code, so only put values there that are safe to expose.

# --- App -------------------------------------------------------------------
# Base URL of the running app; used for redirects after the Gmail OAuth flow.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Dashboard > Project Settings > API (or `pnpm supabase status` when running locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Same value as NEXT_PUBLIC_SUPABASE_URL (read by /api/update-call).
SUPABASE_URL=
# Admin keys that bypass Row Level Security. Server only, never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY is read by /api/make-call; SUPABASE_SERVICE_ROLE_KEY by
# /api/update-call and the Google OAuth routes.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (statement extraction) --------------------------------------
# https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# --- NLPearl (AI bank calls) -----------------------------------------------
# NLPearl dashboard. PEARL_ID is the outbound agent that places the calls.
NLPEARL_ACCOUNT_ID=
NLPEARL_SECRET_KEY=
NLPEARL_PEARL_ID=

# --- Google OAuth (send hardship emails via the user's Gmail) --------------
# Google Cloud Console > APIs & Services > Credentials (OAuth client, Gmail API enabled).
# The redirect URI must also be listed as an authorized redirect URI on the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Plaid (sandbox; not used by any page yet) -----------------------------
# https://dashboard.plaid.com > Developers > Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
